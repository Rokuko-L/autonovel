# ============================================================================
# Provider configuration — autonovel speaks both Anthropic and OpenAI dialects.
# Any compatible endpoint works: first-party APIs, OpenRouter, Groq, Together,
# LiteLLM proxies, DeepSeek compat, vLLM/Ollama. See Docs/core/llm-client.md.
# ============================================================================

# API dialect: "anthropic" or "openai". If unset, inferred from which key is
# present (OPENAI_API_KEY set + ANTHROPIC_API_KEY unset -> openai).
# AUTONOVEL_PROVIDER=openai

# Per-role dialect override (optional). Example: cheap OpenAI writer,
# strong Anthropic judge:
# AUTONOVEL_JUDGE_PROVIDER=anthropic

# --- Anthropic dialect (also used by DeepSeek's Compatibility Layer) ---
# ANTHROPIC_API_KEY=sk-ant-...
# For DeepSeek:
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# --- OpenAI dialect (first-party / OpenRouter / Groq / Together / LiteLLM) ---
# OPENAI_API_KEY=sk-or-v1-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Local servers work too, keyless: OPENAI_BASE_URL=http://localhost:11434/v1

# Gateway-specific headers, merged into every request (JSON object).
# OpenRouter example:
# AUTONOVEL_EXTRA_HEADERS={"HTTP-Referer": "https://your-site.example", "X-Title": "autonovel"}

# --- Models (free-form ids; gateway namespacing like deepseek/deepseek-v4-pro works) ---

# Writer model (drafting and revision)
# DeepSeek: deepseek-v4-flash | OpenRouter: anthropic/claude-sonnet-4.5
AUTONOVEL_WRITER_MODEL=deepseek-v4-flash

# Judge model (evaluation, comparisons, adversarial editing — should differ from writer)
AUTONOVEL_JUDGE_MODEL=deepseek-v4-pro

# Review model (deep prose-level analysis, used in Phase 3b)
AUTONOVEL_REVIEW_MODEL=deepseek-v4-pro
